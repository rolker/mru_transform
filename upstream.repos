# Unreleased source dependencies for mru_transform CI, cloned by industrial_ci
# (UPSTREAM_WORKSPACE) into the upstream workspace and built before this
# package. Mirrors sensors_ws/src/cube_bathymetry/upstream.repos, which already
# declares unh_marine_autonomy for the same library.
#
# unh_marine_autonomy carries marine_vertical_datum, the ROS-free vertical-datum
# library chart_datum_node consumes (ADR-0010 D6, #41). It is not a rosdep key,
# so a clean-container build cannot resolve it without this file -- and
# find_package(marine_vertical_datum REQUIRED) is a build stopper.
#
# geographic_info carries geodesy, used by mru_transform_node and
# nav_sat_fix_to_velocity.
repositories:
  unh_marine_autonomy:
    type: git
    url: https://github.com/rolker/unh_marine_autonomy.git
    version: jazzy
  geographic_info:
    type: git
    url: https://github.com/ros-geographic-info/geographic_info.git
    version: ros2
